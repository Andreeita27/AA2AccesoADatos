  "item": [
    {
      "name": "/post ok",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Response structure is correct\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData).to.have.all.keys(\r",
              "        \"id\",\r",
              "        \"clientName\",\r",
              "        \"clientSurname\",\r",
              "        \"email\",\r",
              "        \"phone\",\r",
              "        \"birthDate\",\r",
              "        \"showPhoto\",\r",
              "        \"visits\"\r",
              "    );\r",
              "\r",
              "    pm.expect(jsonData.id).to.be.a(\"number\");\r",
              "    pm.expect(jsonData.clientName).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.clientSurname).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.email).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.phone).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.birthDate).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.showPhoto).to.be.a(\"boolean\");\r",
              "    pm.expect(jsonData.visits).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response values are correct\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.clientName).to.eql(\"Andrea\");\r",
              "    pm.expect(jsonData.clientSurname).to.eql(\"Fernandez\");\r",
              "    pm.expect(jsonData.email).to.eql(pm.environment.get(\"uniqueEmail\"));\r",
              "    pm.expect(jsonData.phone).to.eql(\"123456789\");\r",
              "    pm.expect(jsonData.birthDate).to.eql(\"1998-01-26\");\r",
              "    pm.expect(jsonData.showPhoto).to.eql(true);\r",
              "    pm.expect(jsonData.visits).to.eql(0);\r",
              "});\r",
              "\r",
              "pm.environment.set(\"clientId\", pm.response.json().id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const uniqueEmail = \"andrea+\" + Date.now() + \"@test.com\";\r",
              "pm.environment.set(\"uniqueEmail\", uniqueEmail);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
