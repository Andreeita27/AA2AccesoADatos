    {
      "name": "/get all ok",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is an array\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Each client has the correct structure\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    jsonData.forEach(client => {\r",
              "        pm.expect(client).to.have.all.keys(\r",
              "            \"id\",\r",
              "            \"clientName\",\r",
              "            \"clientSurname\",\r",
              "            \"email\",\r",
              "            \"phone\",\r",
              "            \"birthDate\",\r",
              "            \"showPhoto\",\r",
              "            \"visits\"\r",
              "        );\r",
              "\r",
              "        pm.expect(client.id).to.be.a(\"number\");\r",
              "        pm.expect(client.clientName).to.be.a(\"string\");\r",
              "        pm.expect(client.clientSurname).to.be.a(\"string\");\r",
              "        pm.expect(client.email).to.be.a(\"string\");\r",
              "        pm.expect(client.phone).to.be.a(\"string\");\r",
              "        pm.expect(client.birthDate).to.be.a(\"string\");\r",
              "        pm.expect(client.showPhoto).to.be.a(\"boolean\");\r",
              "        pm.expect(client.visits).to.be.a(\"number\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Created client appears in the list\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    const clientId = Number(pm.environment.get(\"clientId\"));\r",
              "\r",
              "    const createdClient = jsonData.find(client => client.id === clientId);\r",
              "    pm.expect(createdClient).to.exist;\r",
              "    pm.expect(createdClient.clientName).to.eql(\"Andrea\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
