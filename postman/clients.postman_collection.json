              "pm.test(\"Validation errors are returned\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.errors.clientName).to.exist;\r",
              "    pm.expect(jsonData.errors.clientSurname).to.exist;\r",
              "    pm.expect(jsonData.errors.email).to.exist;\r",
              "});"
