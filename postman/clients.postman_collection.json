  "item": [
    {
      "name": "/post ok",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has client id\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.id).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains the created client name\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.clientName).to.eql(\"Andrea\");\r",
              "});\r",
              "\r",
              "pm.environment.set(\"clientId\", pm.response.json().id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const uniqueEmail = \"andrea+\" + Date.now() + \"@test.com\";\r",
              "pm.environment.set(\"uniqueEmail\", uniqueEmail);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"clientName\": \"Andrea\",\r\n  \"clientSurname\": \"Fernandez\",\r\n  \"email\": \"{{uniqueEmail}}\",\r\n  \"phone\": \"123456789\",\r\n  \"birthDate\": \"1998-01-26\",\r\n  \"showPhoto\": true\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/clients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clients"
          ]
        }
      },
      "response": []
    },
